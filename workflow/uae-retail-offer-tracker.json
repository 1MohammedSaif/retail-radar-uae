    {
      "parameters": {
        "jsCode": "const activeFlyers = [];\n\n// Change the outer loop and the dynamicStore definition to this:\nconst items = $input.all();\n\nfor (let k = 0; k < items.length; k++) {\n  const item = items[k];\n  const rawHtml = item.json.data; \n  if (!rawHtml) continue;\n\n  const dynamicStore = $('Scraper Config').all()[k].json.store || \"Unknown Store\";\n\n  // Split the page into individual catalog card blocks\n  const cards = rawHtml.split(/class=\"[^\"]*product-container[^\"]*\"|class=\"[^\"]*catalog-item[^\"]*\"/);\n  \n  for (let i = 1; i < cards.length; i++) {\n    const cardContent = cards[i];\n    \n    if (cardContent.includes(\"Expired\")) {\n      continue;\n    }\n    \n    const hrefMatch = cardContent.match(/href=\"([^\"]*\\/catalogs\\/[^\"]*)\"/);\n    const titleMatch = cardContent.match(/<h4[^>]*>([\\s\\S]*?)<\\/h4>/) || cardContent.match(/class=\"product-name\"[^>]*>([\\s\\S]*?)<\\/div>/);\n    const dateMatch = cardContent.match(/class=\"catalog-date\"[^>]*>([\\s\\S]*?)<\\/span>/);\n    \n    // Extract the thumbnail image source URL from the card\n    const imgMatch = cardContent.match(/src=\"([^\"]*)\"/) || cardContent.match(/data-src=\"([^\"]*)\"/);\n\n    if (hrefMatch && hrefMatch[1]) {\n      let flyerUrl = hrefMatch[1];\n      if (!flyerUrl.startsWith('http')) {\n        flyerUrl = `https://www.wowdeals.me${flyerUrl}`;\n      }\n            \n      const cleanTitle = titleMatch ? titleMatch[1].replace(/<[^>]*>/g, '').replace(/&amp;/g, '&').replace(/&#039;/g, \"'\").trim() : \"New Flyer\";\n      const cleanValidity = dateMatch ? dateMatch[1].replace(/<[^>]*>/g, '').trim() : \"Active\";\n      \n      // Clean and handle relative image URLs\n      let imageUrl = imgMatch ? imgMatch[1] : \"\";\n      if (imageUrl && !imageUrl.startsWith('http')) {\n        imageUrl = `https://www.wowdeals.me${imageUrl}`;\n      }\n\n      activeFlyers.push({\n        json: {\n          store: dynamicStore,\n          flyer_url: flyerUrl,\n          title: cleanTitle,\n          validity: cleanValidity,\n          image_url: imageUrl, \n          status: \"Active\"\n        }\n      });\n    }\n  }\n}\n\nreturn activeFlyers;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
