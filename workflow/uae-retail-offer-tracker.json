    {
      "parameters": {
        "jsCode": "const months = {\n  jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5,\n  jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11\n};\n\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst expiredItems = [];\n\nfor (const item of $input.all()) {\n  const validityRaw = item.json.validity || '';\n  let expiryDate = null;\n\n  // Try standard ISO date parsing first\n  if (!isNaN(Date.parse(validityRaw))) {\n    expiryDate = new Date(validityRaw);\n  } else {\n    // Extract date patterns like \"28 Sep\" or \"28 September\"\n    const match = validityRaw.match(/(\\d{1,2})\\s*([a-zA-Z]{3,})/);\n    if (match) {\n      const day = parseInt(match[1], 10);\n      const monthStr = match[2].substring(0, 3).toLowerCase();\n      \n      if (months[monthStr] !== undefined) {\n        // Assume current year (or next year if rolled over)\n        const year = today.getFullYear();\n        expiryDate = new Date(year, months[monthStr], day);\n      }\n    }\n  }\n\n  // If parsed successfully and the date is before today, keep item for cleanup\n  if (expiryDate && expiryDate < today) {\n    expiredItems.push(item);\n  }\n}\n\nreturn expiredItems;"
      },
