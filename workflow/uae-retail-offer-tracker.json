        "jsCode": "return [\n  { json: { store: \"Carrefour\", url: \"https://www.wowdeals.me/ae/carrefour/catalogs\" } },\n  { json: { store: \"Lulu\", url: \"https://www.wowdeals.me/ae/lulu/catalogs\" } },\n  { json: { store: \"Viva\", url: \"https://www.wowdeals.me/ae/viva/catalogs\" } },\n  { json: { store: \"Al Maya\", url: \"https://www.wowdeals.me/ae/al-maya/catalogs\" } },\n  { json: { store: \"Choithrams\", url: \"https://www.wowdeals.me/ae/choithrams/catalogs\" } },\n  { json: { store: \"Sava\", url: \"https://www.wowdeals.me/ae/sava/catalogs\" } }\n];"
